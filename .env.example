# ---------------------------------------------------------------------------
# velmire-scraper configuration
# Copy this file to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# --- HTTP API -------------------------------------------------------------
HOST=0.0.0.0
PORT=3000

# --- Redis (cache) --------------------------------------------------------
REDIS_URL=redis://127.0.0.1:6379

# --- LK21 (LayarKaca21) source --------------------------------------------
# Single source (Nontondrama tv9).
LK21_URL=https://tv9.nontondrama.my
# Portal film memakai sumber yang sama (tv9).
LK21_MOVIES_URL=https://tv9.nontondrama.my
# Base URL pencarian. tv9 memakai sitemap sebagai fallback.
LK21_SEARCH_URL=https://tv9.nontondrama.my/
# Base URL poster relatif.
LK21_POSTER_URL=https://tv9.nontondrama.my/wp-content/uploads/
# Referer untuk API pencarian. Kosongkan untuk deteksi otomatis dari mirror LK21_URL.
LK21_REFERER=

# --- Allowed targets (SSRF / allowlist) -----------------------------------
# Comma separated. Wildcards allowed: *.example.com
# Leave empty to auto-allow the hosts of LK21_URL / LK21_MOVIES_URL /
# LK21_SEARCH_URL / LK21_POSTER_URL.
ALLOWED_HOSTS=
# Only these ports may be requested.
ALLOWED_PORTS=80,443
# Only enable for local testing. Never in production.
ALLOW_PRIVATE_HOSTS=false

# --- Fetch behaviour ------------------------------------------------------
FETCH_TIMEOUT_MS=15000
FETCH_MAX_REDIRECTS=3
MAX_HTML_BYTES=2000000
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
ACCEPT_LANGUAGE=id-ID,id;q=0.9,en-US;q=0.8,en;q=0.7

# --- Python CloudScraper sidecar ------------------------------------------
CLOUDSCRAPER_ENABLED=true
CLOUDSCRAPER_URL=http://127.0.0.1:8000
CLOUDSCRAPER_TIMEOUT_MS=30000
# Host yang boleh di-fetch sidecar. Kosong = semua host (host privat diblok).
CLOUDSCRAPER_ALLOWED_HOSTS=*.nontondrama.my
CLOUDSCRAPER_MAX_BYTES=2000000
# Profil browser cloudscraper: chrome | firefox | native
CLOUDSCRAPER_BROWSER=chrome
# Jeda (detik) sebelum cloudscraper menyelesaikan challenge; 0 = tanpa jeda.
CLOUDSCRAPER_DELAY=0
CLOUDSCRAPER_TOKEN=

# --- Stream proxy ---------------------------------------------------------
# Secret HMAC untuk token `/stream/:token`. Kosong = acak saat boot (token
# lama tidak valid setelah restart). Isi nilai acak panjang di produksi.
STREAM_SECRET=
# Masa berlaku token stream (detik).
STREAM_TOKEN_TTL_SECONDS=21600
# Base URL publik API. Kosong = URL `hls` relatif (same-origin).
PUBLIC_BASE_URL=

# --- Cache / limits -------------------------------------------------------
CACHE_TTL_SECONDS=1800
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000
CORS_ORIGIN=*

# --- Pagination -----------------------------------------------------------
# Maximum number of source pages a single request may aggregate.
MAX_PAGES_PER_REQUEST=20
# Default number of items returned per listing when `limit` is not set.
DEFAULT_LIST_LIMIT=24
