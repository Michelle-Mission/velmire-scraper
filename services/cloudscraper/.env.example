# Velmire CloudScraper sidecar
CLOUDSCRAPER_HOST=127.0.0.1
CLOUDSCRAPER_PORT=8000
# Optional comma-separated allowlist. Empty = rely on the Node.js API allowlist.
CLOUDSCRAPER_ALLOWED_HOSTS=
# Never enable in production.
CLOUDSCRAPER_ALLOW_PRIVATE=false
# Optional shared secret; must match the Node.js CLOUDSCRAPER_TOKEN.
CLOUDSCRAPER_TOKEN=
CLOUDSCRAPER_MAX_BYTES=2000000
CLOUDSCRAPER_TIMEOUT_MS=30000
