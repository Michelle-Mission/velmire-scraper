{
  "name": "velmire-scraper",
  "version": "1.0.0",
  "private": true,
  "description": "LK21 (LayarKaca21) web scraper: Fastify REST API (+ /v1) + Redis cache + Python CloudScraper sidecar.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start:api": "node dist/api/index.js",
    "dev:api": "tsx watch src/api/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "redis:start": "redis-server --port 6379 --save \"\" --appendonly no",
    "py:install": "pip install -r services/cloudscraper/requirements.txt",
    "py:start": "python3 services/cloudscraper/main.py"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "axios": "^1.20.0",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^5.0.5"
  }
}
